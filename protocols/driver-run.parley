# One ship driver run, as actually practiced — reverse-engineered from
# ~/.workbench/driver-state (see observer/extract_driver.py for the
# record -> event mapping). The operator imports a spec; the driver
# dispatches a worker and reads its attempt; each round is one three-way
# call: land it (PR opened, pinned merge, recorded finish), retry with a
# fresh dispatch, or skip the stream and finish.
protocol driver-run
roles operator driver worker repo

operator -> driver: run.spec
loop attempt {
  driver -> worker: dispatch
  worker -> driver: attempt
  choice driver observes operator worker repo {
    landed {
      worker -> repo: pr.opened
      driver -> repo: merge
      driver -> operator: finished
    }
    retry {
      continue attempt
    }
    skipped {
      driver -> operator: skipped
      driver -> operator: finished
    }
  }
}
