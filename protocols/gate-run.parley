# One gate run, as actually practiced — reverse-engineered from
# ~/dev/gate/state/log.jsonl and refined until real history classifies
# cleanly (see observer/extract_gate.py for the record -> event mapping).
#
# Collector bundles PR evidence, the verdict panel reports, then each
# round gate passes (pinned merge command) or parks — to the judge, or to
# the operator once a grant ceiling is hit. The operator decides how any
# park comes back: a judge judgment (re-verdict, next round) or a named
# human resolution (terminal). Formerly a 744-line generated unroll;
# `loop` expresses it directly.
protocol gate-run
roles collector panel gate judge operator

collector -> gate: evidence.bundle
panel -> gate: verdicts
loop review {
  choice gate observes collector panel judge operator {
    pass {
      gate -> operator: merge.command
    }
    parked {
      choice gate observes collector panel judge operator {
        tojudge {
          gate -> judge: escalation
          choice operator observes collector panel gate judge {
            judged {
              judge -> gate: judgment
              panel -> gate: re.verdicts
              continue review
            }
            resolved {
              operator -> gate: resolution
            }
          }
        }
        ceiling {
          gate -> operator: escalation.ceiling
          choice operator observes collector panel gate judge {
            judged {
              judge -> gate: judgment
              panel -> gate: re.verdicts
              continue review
            }
            resolved {
              operator -> gate: resolution
            }
          }
        }
      }
    }
  }
}
